# Hostinger & Apache Clean URLs (.htaccess)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Disable DirectorySlash to prevent automatic 301 redirects on folders
    DirectorySlash Off

    # Prevent 404 caching for assets
    <FilesMatch "\.(css|js|svg|jpg|jpeg|png|gif|ico|webp)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # Serve existing files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Redirect .html URLs to clean URLs (e.g. /services/seo.html -> /services/seo)
    RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Handle subfolder clean URLs (e.g. /services/seo -> /services/seo.html)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # Handle directory index files (e.g. /services/ -> /services/index.html)
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

# MIME types for Web assets
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType image/jpeg .jpg .jpeg
    AddType image/png .png
</IfModule>
